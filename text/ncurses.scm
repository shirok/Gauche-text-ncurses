  (define-c-function wgetch `(,<WINDOW*>) 'int)
  (define-c-function mvgetch '(int int) 'int)
  (define-c-function mvwgetch `(,<WINDOW*> int int) 'int)
  (define-c-function ungetch '(int) 'int)
  (define-c-function has-key '(int) <c-bool>)

  ;; printw(3)
