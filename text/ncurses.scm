  (define-c-constant A-INVIS)
  (define-c-constant A-PROTECT)
  (define-c-constant A-HORIZONTAL)
  (define-c-constant A-LEFT)
  (define-c-constant A-LOW)
  (define-c-constant A-RIGHT)
  (define-c-constant A-TOP)
  (define-c-constant A-VERTICAL)
  (define-c-constant A-ITALIC)
