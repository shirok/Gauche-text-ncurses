  (define-c-constant WA_ALTCHARSET)
  (define-c-constant WA_INVIS)
  (define-c-constant WA_PROTECT)
  (define-c-constant WA_HORIZONTAL)
  (define-c-constant WA_LEFT)
  (define-c-constant WA_LOW)
  (define-c-constant WA_RIGHT)
  (define-c-constant WA_TOP)
  (define-c-constant WA_VERTICAL)
  (define-c-constant WA_ITALIC)

  ;; curs_color(3x) - colors
  (define-c-constant COLOR_BLACK)
  (define-c-constant COLOR_RED)
  (define-c-constant COLOR_GREEN)
  (define-c-constant COLOR_YELLOW)
  (define-c-constant COLOR_BLUE)
  (define-c-constant COLOR_MAGENTA)
  (define-c-constant COLOR_CYAN)
