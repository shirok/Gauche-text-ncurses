  (define-c-constant WA-STANDOUT)
  (define-c-constant WA-UNDERLINE)
  (define-c-constant WA-REVERSE)
  (define-c-constant WA-BLINK)
  (define-c-constant WA-DIM)
  (define-c-constant WA-BOLD)
  (define-c-constant WA-ALTCHARSET)
  (define-c-constant WA-INVIS)
  (define-c-constant WA-PROTECT)
  (define-c-constant WA-HORIZONTAL)
  (define-c-constant WA-LEFT)
  (define-c-constant WA-LOW)
  (define-c-constant WA-RIGHT)
  (define-c-constant WA-TOP)
  (define-c-constant WA-VERTICAL)
  (define-c-constant WA-ITALIC)

  ;; curs_color(3x) - colors
  (define-c-constant COLOR-BLACK)
  (define-c-constant COLOR-RED)
  (define-c-constant COLOR-GREEN)
  (define-c-constant COLOR-YELLOW)
  (define-c-constant COLOR-BLUE)
  (define-c-constant COLOR-MAGENTA)
  (define-c-constant COLOR-CYAN)
  (define-c-constant COLOR-WHITE)

  ;; curs_getch(3x) - key codes
