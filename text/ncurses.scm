  (define-c-function wprintw `(,<WINDOW*> ,<c-string> ...) 'int)
  (define-c-function mvprintw `(int int ,<c-string> ...) 'int)
  (define-c-function mvwprintw `(int int ,<WINDOW*> ,<c-string> ...) 'int)
  ;; vwprintw, vw_printw - no va_list
  )
