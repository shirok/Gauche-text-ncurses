;;;
;;; ncurses binding
;;;

(define-module text.ncurses
  (use gauche.native-type)
  (use gauche.ffi)
  (export-all)                          ;for now
  )
(select-module text.ncurses)

;; We treat these as pointer to an opaque object
(define-type <WINDOW*> (make-c-opaque-pointer-type 'WINDOW))
(define-type <SCREEN*> (make-c-opaque-pointer-type 'SCREEN))

(with-ffi (dlopen "libncurses" :versions '(6)) (:c-headers ("ncurses.h"))
  ;; Constants
  ;; NB: TRUE and FALSE are omitted; use #t and #f.
  (define-c-constant NCURSES-VERSION <c-string>)
  (define-c-constant NCURSES-MOUSE-VERSION)
  (define-c-constant ERR)
  (define-c-constant OK)

  ;; curs_attr(3x) - video attributes
  ;; NB: *-ATTRIBUTES is ~0 cast to chtype (32bit)
  (define-c-constant A-NORMAL)
  (define-c-constant A-ATTRIBUTES <uint32>)
  (define-c-constant A-CHARTEXT)
  (define-c-constant A-COLOR)
  (define-c-constant A-STANDOUT)
  (define-c-constant A-UNDERLINE)
  (define-c-constant A-REVERSE)
  (define-c-constant A-BLINK)
