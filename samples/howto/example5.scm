(use text.ncurses)

(define (main args)
  (unless (length=? args 2)
    (exit 1 "Usage: ~s <a c file name>\n" (car args)))
  (call-with-input-file (cadr args)
    (^p (unless p
          (exit 1 "Cannot open input file: ~s" (cadr args)))
        (initscr)
        (receive [row col] (getmaxyx stdscr)
          (let loop ([prev #f]
                     [ch (read-char p)])
            (unless (eof-object? ch)
              (receive [y x] (getyx stdscr)
                (when (= y (- row 1))
                  (printw "<-Press Any Key->")
                  (getch)
                  (clear)
                  (move 0 0))
                (if (and (eqv? prev #\/)
                         (eqv? ch #\*))
                  (begin
                    (attron A_BOLD)
                    (set!-values [y x] (getyx stdscr))
                    (move y (- x 1))
                    (printw "%c%c" #\/ ch))
                  (printw "%c" ch)))
              (refresh)
              (when (and (eqv? prev #\*)
                         (eqv? ch #\/))
                (attroff A_BOLD))
              (loop ch (read-char p)))))
        (endwin))
    :if-does-not-exist #f)
  0)
